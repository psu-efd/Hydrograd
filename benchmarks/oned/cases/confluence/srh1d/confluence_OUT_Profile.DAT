# TITLE= "bed profile"
# t         = time(hr)
# riv       = river number
# xcid      = identification string for cross section
# xc        = cross section number
# xt        = cross section location (ft or m)
# q         = discharge (cfs or m^3/s)
# qlatf     = lateral flow discharge (cfs or m^3/s)
# zb        = current thalweg elevation (ft or m)
# z         = current water surface elevation (ft or m)
# zba       = average bed elevation of the main channel (ft or m)
# fslope    = friction slope (-)
# topw      = top width (ft or m)
# hydrad    = hydraulic radius (ft or m)
# vel       = average velocity for xc (ft/s or m/s)
# d16       = diameter that 16% of sediment is finer than in top bed layer (mm)
# d30       = diameter that 30% of sediment is finer than in top bed layer (mm)
# d50       = diameter that 50% of sediment is finer than in top bed layer (mm)
# d84       = diameter that 84% of sediment is finer than in top bed layer (mm)
# vol_dep   = cumulative bulk volume of sediment deposition of entire cross section (ft^3 or m^3)
# sed_load  = cumulative weight of sediment passing cross section (ton or metric ton)
# bank_eros = cumulative volume of bank erosion (ft^3 or m^3)
# rock_eros = cummulative volume of rock erosion (ft^3 or m^3)
# vol_water = cummulative volume of water passing cross section (ft^3 or m^3)
 t,riv,xcid,xc,xt,q,qlatf,zb,z,zba,fslope,topw,hydrad,vel,d16,d30,d50,d84,vol_dep,sed_load,bank_eros,rock_eros,vol_water
